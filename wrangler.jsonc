{
  "name": "heydock",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "vars": {
    "HEYDOCK_TO_EMAIL": "operations@hdocks.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  }
}
