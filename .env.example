# Build-time (Cloudflare Pages build env or local shell)
# Verified operator fields also live in content/site.json; env overrides that file.
HEYDOCK_ORIGIN=https://www.example.com
HEYDOCK_PUBLIC=1
HEYDOCK_CONTACT_EMAIL=hey@heydock.com
HEYDOCK_OPERATOR_NAME=Infintree Limited
HEYDOCK_COMPANY_NUMBER=17100814
HEYDOCK_REGISTERED_OFFICE=Flat, 38a The Common, Hatfield, United Kingdom, AL10 0LU
HEYDOCK_REGISTRATION_JURISDICTION=England and Wales
HEYDOCK_VAT_NUMBER=

# Runtime secrets for Pages Functions (Cloudflare Pages → Settings → Environment variables)
# Keep RESEND_API_KEY as a secret. Use a Resend-verified sender for HEYDOCK_FROM_EMAIL.
RESEND_API_KEY=re_xxxxxxxx
HEYDOCK_FROM_EMAIL=HeyDock <hello@your-verified-domain>
HEYDOCK_TO_EMAIL=hey@heydock.com
