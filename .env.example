# Build-time (Cloudflare Pages build env or local shell)
# Verified operator fields also live in content/site.json; env overrides that file.
HEYDOCK_ORIGIN=https://www.example.com
HEYDOCK_PUBLIC=1
HEYDOCK_CONTACT_EMAIL=enquiries@example.com
HEYDOCK_OPERATOR_NAME=
HEYDOCK_COMPANY_NUMBER=
HEYDOCK_REGISTERED_OFFICE=
HEYDOCK_REGISTRATION_JURISDICTION=
HEYDOCK_VAT_NUMBER=

# Runtime secrets for Pages Functions (never commit real values)
RESEND_API_KEY=re_xxxxxxxx
HEYDOCK_FROM_EMAIL=HeyDock <hello@example.com>
HEYDOCK_TO_EMAIL=enquiries@example.com
