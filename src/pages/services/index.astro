---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { CATEGORIES } from '../../data/taxonomy';
import { site } from '../../data/site';

const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const groups = CATEGORIES.map((c) => ({
  ...c,
  items: all.filter((s) => s.data.category === c.name),
}));
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.origin}/services` },
  ],
};
---
<Base
  title="IT Services in the UK | HeyDock"
  description="Browse HeyDock services: staffing, managed IT, networks, cloud, cybersecurity, software, AI automation and consulting for UK businesses and MSPs."
  keywords="IT services UK, managed IT, IT staffing, cybersecurity UK, cloud management, IT consulting"
  canonicalPath="/services"
  jsonLd={[crumbs]}
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">What we do</p>
      <h1>Services for UK businesses and MSPs</h1>
      <p class="lede">Every service below has its own page, with scope, limits and a way to request a quote. We start from a written brief, and we will not invent coverage, certifications or savings.</p>
    </div>
  </section>
  {groups.map((g) => (
    <section class="section white">
      <div class="wrap">
        <p class="kicker">{g.name}</p>
        <h2>{g.name}</h2>
        <div class="grid-3">
          {g.items.map((s) => (
            <a class="card reveal" href={`/services/${s.id}`}>
              <h3>{s.data.h1}</h3>
              <p>{s.data.summary}</p>
              <p class="more">Read more</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
  <CtaBand />
</Base>
