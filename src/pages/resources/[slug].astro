---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
export async function getStaticPaths() {
  const pages = await getCollection('resources');
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const services = await getCollection('services');
const related = (entry.data.relatedServices || []).map((id) => services.find((s) => s.id === id)).filter(Boolean);
const jsonLd = [];
if (entry.data.faqs?.length) {
  jsonLd.push({ '@type': 'FAQPage', mainEntity: entry.data.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
}
jsonLd.push({
  '@type': 'Article',
  headline: entry.data.h1,
  description: entry.data.description,
  datePublished: entry.data.date,
  author: { '@id': `${site.origin}/#organization` },
  publisher: { '@id': `${site.origin}/#organization` },
});
jsonLd.push({
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: `${site.origin}/resources` },
    { '@type': 'ListItem', position: 3, name: entry.data.h1, item: `${site.origin}/resources/${entry.id}` },
  ],
});
---
<Base title={entry.data.title} description={entry.data.description} keywords={entry.data.keywords} canonicalPath={`/resources/${entry.id}`} jsonLd={jsonLd}>
  <section class="page-hero"><div class="wrap">
    <p class="kicker">Resources</p>
    <h1>{entry.data.h1}</h1>
    <p class="lede">{entry.data.summary}</p>
  </div></section>
  <section class="section white"><div class="wrap">
    <article class="prose reveal"><Content /></article>
    {entry.data.faqs?.length ? <div class="faq reveal"><h2>Questions</h2>{entry.data.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div> : null}
    {related.length ? <div class="related reveal" style="margin-top:2rem"><h2>Related services</h2><div class="grid-3">{related.map((s) => <a class="card" href={`/services/${s.id}`}><h3>{s.data.h1}</h3><p>{s.data.summary}</p></a>)}</div></div> : null}
  </div></section>
  <CtaBand />
</Base>
