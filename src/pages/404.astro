---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | HeyDock" description="The page you requested is not on the HeyDock website. Try the services list or send an enquiry." canonicalPath="/404" noindex={true}>
  <section class="page-hero"><div class="wrap">
    <p class="kicker">404</p>
    <h1>This page is not here</h1>
    <p class="lede">The address may have changed as we moved to clean URLs. Try the <a href="/services">services list</a>, the <a href="/">home page</a>, or <a href="/contact">send an enquiry</a>.</p>
  </div></section>
</Base>
