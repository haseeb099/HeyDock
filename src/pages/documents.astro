---
import Base from '../layouts/Base.astro';
---
<Base title="Documents and Policies | HeyDock" description="Website policies, working practices and MSP onboarding information for HeyDock in one place." canonicalPath="/documents">
  <section class="page-hero"><div class="wrap">
    <p class="kicker">Documents and policies</p>
    <h1>Policies and working practices in one place</h1>
    <p class="lede">Short links to website policies, how engagements work, and MSP onboarding information.</p>
  </div></section>
  <section class="section white"><div class="wrap">
    <h2>Website policies</h2>
    <p>How this site and your data are handled.</p>
    <div class="grid-2" style="margin:1.2rem 0 2.5rem">
      <a class="card" href="/privacy"><h3>Privacy notice</h3><p>Enquiry handling, processors and your rights.</p></a>
      <a class="card" href="/cookies"><h3>Cookies and storage</h3><p>What this site actually uses in the browser.</p></a>
      <a class="card" href="/terms"><h3>Website terms</h3><p>Use of the site, IP and when enquiries become agreements.</p></a>
      <a class="card" href="/accessibility"><h3>Accessibility</h3><p>Features, limitations and how to report issues.</p></a>
      <a class="card" href="/complaints"><h3>Complaints</h3><p>How to raise a concern and how it is handled.</p></a>
    </div>
    <h2>Working with HeyDock</h2>
    <p>Delivery, support and data handling.</p>
    <div class="grid-2" style="margin:1.2rem 0 2.5rem">
      <a class="card" href="/how-we-work"><h3>How we work</h3><p>From enquiry and quote through delivery and handover.</p></a>
      <a class="card" href="/support-and-escalation"><h3>Support and escalation</h3><p>How to request help and how urgency is assessed.</p></a>
      <a class="card" href="/security-and-data-handling"><h3>Security and data handling</h3><p>Site access, credentials and customer information.</p></a>
    </div>
    <h2>MSP onboarding</h2>
    <p>Partner-facing process information.</p>
    <div class="grid-2" style="margin:1.2rem 0 2.5rem">
      <a class="card" href="/vendor-onboarding"><h3>Vendor onboarding</h3><p>White-label communication, scope, reporting and escalation.</p></a>
      <a class="card" href="/partners"><h3>IT partners overview</h3><p>What partners can book and how fulfilment works.</p></a>
    </div>
    <div class="prose">
      <h2>Downloads</h2>
      <p>No approved public downloads are published on this site yet. NDAs, MSAs, statements of work, SLAs, DPAs, insurance evidence and internal templates are discussed privately when applicable and are not hosted here unless separately approved.</p>
    </div>
  </div></section>
</Base>
