---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base title="Solutions | HeyDock" description="Common HeyDock starting points: a first site visit, an MSP overflow arrangement, a tenant tidy-up, or a bounded hiring or automation brief." canonicalPath="/solutions">
  <section class="page-hero"><div class="wrap">
    <p class="kicker">Solutions</p>
    <h1>Common starting points</h1>
    <p class="lede">If you are not sure which service page to open, these are typical ways work begins.</p>
  </div></section>
  <section class="section white"><div class="wrap grid-2">
    <a class="card" href="/services/engineer-dispatch"><h2>A first site visit</h2><p>Confirm the town, the task and the access, then attend.</p></a>
    <a class="card" href="/industries/managed-service-providers"><h2>MSP overflow</h2><p>White-label hands on a site you cannot reach this week.</p></a>
    <a class="card" href="/services/microsoft-365"><h2>A Microsoft 365 tidy-up</h2><p>Identity, sharing and admin roles, sequenced so people can still work.</p></a>
    <a class="card" href="/services/it-staffing-recruitment"><h2>A hiring brief</h2><p>Write the role, then search, rather than circulating a loose longlist.</p></a>
    <a class="card" href="/services/ai-automation"><h2>A bounded AI pilot</h2><p>One workflow, a success check, and permission to stop.</p></a>
    <a class="card" href="/services"><h2>The full services list</h2><p>Every offer, grouped, with its own page.</p></a>
  </div></section>
  <CtaBand />
</Base>
