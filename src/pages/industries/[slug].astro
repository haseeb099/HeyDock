---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const pages = await getCollection('industries');
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const services = await getCollection('services');
const related = entry.data.services.map((id) => services.find((s) => s.id === id)).filter(Boolean);
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: entry.data.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.origin}/` },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: `${site.origin}/industries` },
    { '@type': 'ListItem', position: 3, name: entry.data.h1, item: `${site.origin}/industries/${entry.id}` },
  ],
};
---
<Base title={entry.data.title} description={entry.data.description} keywords={entry.data.keywords} canonicalPath={`/industries/${entry.id}`} jsonLd={[faqLd, crumbs]}>
  <section class="page-hero"><div class="wrap">
    <p class="kicker">Industries</p>
    <h1>{entry.data.h1}</h1>
    <p class="lede">{entry.data.summary}</p>
  </div></section>
  <section class="section white"><div class="wrap">
    <article class="prose reveal"><Content /></article>
    <div class="related reveal" style="margin-top:2.5rem">
      <h2>Related services</h2>
      <div class="grid-3">{related.map((s) => (
        <a class="card" href={`/services/${s.id}`}><h3>{s.data.h1}</h3><p>{s.data.summary}</p></a>
      ))}</div>
    </div>
    <div class="faq reveal"><h2>Questions</h2>
      {entry.data.faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </div></section>
  <CtaBand />
</Base>
